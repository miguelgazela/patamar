# Copiar para .env.local. Valores locais: `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só no servidor, nunca expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# URL público da app (obrigatório em produção: usado nos emails de convite).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email: produção usa Resend (UE); em desenvolvimento usa o Mailpit do Supabase.
RESEND_API_KEY=
EMAIL_FROM="Patamar <avisos@exemplo.pt>"
EMAIL_DEV_URL=http://127.0.0.1:54324

# Segredo do endpoint de envio automático de lembretes (/api/cron/lembretes).
CRON_SECRET=

# Leitura de faturas por fotografia (opcional; sem chave, a despesa preenche-se à mão).
ANTHROPIC_API_KEY=
# Modelo usado na leitura (por omissão: claude-opus-5-5).
ANTHROPIC_MODEL=
